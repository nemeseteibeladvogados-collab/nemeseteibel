      <div class="table-header">
        <h2>Quizzes criados</h2>
        <span class="count">{quizList.length} registros</span>
      </div>

      {quizList.length === 0 ? (
        <div class="empty-state">
          <div class="icon">🧭</div>
          <p>Nenhum quiz criado ainda. Clique em "Novo quiz" para começar.</p>
        </div>
      ) : (
        <table>
          <thead>
            <tr>
              <th>Nome interno</th>
              <th>Source tag</th>
              <th>Perguntas</th>
              <th>Funil</th>
              <th>Status</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            {quizList.map((q) => {
              const stats = funnel[q.id] ?? { started: 0, completed: 0 };
              const rate = stats.started > 0 ? Math.round((stats.completed / stats.started) * 100) : 0;
              return (
                <tr>
                  <td class="td-name" data-label="Nome">{q.name}</td>
                  <td data-label="Source tag"><span class="td-tag">{q.source_tag}</span></td>
                  <td data-label="Perguntas">{q.questions.length}</td>
                  <td data-label="Funil">
                    <span class="funnel">
                      {stats.started}
                      <span class="funnel-arrow">→</span>
                      {stats.completed}
                      <span class="funnel-rate" class:list={[stats.started === 0 && 'zero']}>{rate}%</span>
                    </span>
                  </td>
                  <td data-label="Status">
                    <span class="status-dot" style={`background:${q.is_active ? '#3DBE4F' : '#9A9285'}`}></span>
                    {q.is_active ? 'Ativo' : 'Inativo'}
                  </td>
                  <td data-label="Ações">
                    <div class="actions">
                      <button
                        class="btn-action btn-link"
                        data-copy={`${siteUrl}/q/${q.id}`}
                        onclick="copyText(this)"
                      >
                        Link
                      </button>
                      <button
                        class="btn-action btn-iframe"
                        data-copy={`<iframe src="${siteUrl}/q/${q.id}?embed=1" width="100%" height="560" frameborder="0" style="border-radius:12px;border:none;" title="${q.title}"></iframe>`}
                        onclick="copyText(this)"
                      >
                        Iframe
                      </button>
                      <a class="btn-action btn-answers" href={`/admin/quizzes/${q.id}`}>Respostas</a>
                      <button
                        class="btn-action btn-edit"
                        data-id={q.id}
                        data-quiz={JSON.stringify({
                          name: q.name,
                          title: q.title,
                          subtitle: q.subtitle ?? '',
                          service_interest: q.service_interest ?? '',
                          whatsapp_number: q.whatsapp_number ?? '',
                          meta_title: q.meta_title ?? '',
                          meta_description: q.meta_description ?? '',
                          og_image: q.og_image ?? '',
                          success_message: q.success_message,
                          questions: q.questions,
                        })}
                        onclick="editQuiz(this)"
                      >
                        Editar perguntas
                      </button>
                      <button
                        class="btn-action"
                        class:list={[q.is_active ? 'btn-toggle-on' : 'btn-toggle-off']}
                        data-id={q.id}
                        data-active={String(q.is_active)}
                        onclick="toggleQuiz(this)"
                      >
                        {q.is_active ? 'Desativar' : 'Ativar'}
                      </button>
                      <button
                        class="btn-action btn-delete"
                        data-id={q.id}
                        data-name={q.name}
                        onclick="deleteQuiz(this)"
                      >
                        Excluir
                      </button>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      )}
    </div>
  </main>

  <!-- Modal de criação / edição -->
  <div class="modal-overlay" id="modal-overlay">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <div class="modal-header">
        <h2 id="modal-title">Novo quiz</h2>
        <button class="btn-close" id="btn-close-modal" aria-label="Fechar">✕</button>
      </div>
      <div class="modal-body">
        <div id="modal-error" class="modal-error" style="display:none"></div>
        <form id="quiz-form" class="form-grid" novalidate>
          <div class="form-row">
            <div class="form-group">
              <label for="q-name">Nome interno *</label>
              <input type="text" id="q-name" placeholder="Ex: Quiz - Regularização" required />
              <span class="form-hint">Visível apenas para você no painel</span>
            </div>
            <div class="form-group" id="group-source-tag">
              <label for="q-source-tag">Source tag *</label>
              <input type="text" id="q-source-tag" placeholder="quiz-regularizacao" required />
              <span class="form-hint">Identificador único nos leads</span>
            </div>
          </div>

          <div class="form-group">
            <label for="q-title">Título público *</label>
            <input type="text" id="q-title" placeholder="Ex: Quase lá! Onde enviamos seu resultado?" required />
            <span class="form-hint">Exibido na última etapa, junto ao formulário</span>
          </div>

          <div class="form-group">
            <label for="q-subtitle">Subtítulo</label>
            <input type="text" id="q-subtitle" placeholder="Ex: Um especialista analisa seu caso em até 24h" />
          </div>

          <div class="form-group">
            <label for="q-service">Serviço de interesse</label>
            <input type="text" id="q-service" placeholder="Ex: regularizacao-fundiaria" />
            <span class="form-hint">Salvo em cada lead captado por este quiz</span>
          </div>

          <div class="form-group">
            <label for="q-whatsapp">WhatsApp de destino</label>
            <input type="text" id="q-whatsapp" placeholder="556541410010" />
            <span class="form-hint">Botão na tela final. Em branco usa o número do escritório</span>
          </div>

          <div class="form-group">
            <label for="q-success">Mensagem de sucesso</label>
            <textarea id="q-success" placeholder="Obrigado! Entraremos em contato em breve."></textarea>
          </div>

          <div class="builder">
            <div class="builder-header">
              <div>
                <h3>Compartilhamento</h3>
                <p class="form-hint">O que aparece no preview ao mandar o link no WhatsApp</p>
              </div>
            </div>
            <div class="form-grid" style="gap:1.1rem">
              <div class="form-group">
                <label for="q-meta-title">Título do preview</label>
                <input type="text" id="q-meta-title" placeholder="Sua propriedade rural está regularizada?" />
                <span class="form-hint">Em branco usa o título público, que é o texto da última etapa — quase sempre ruim aqui</span>
              </div>
              <div class="form-group">
                <label for="q-meta-description">Descrição do preview</label>
                <textarea id="q-meta-description" placeholder="5 perguntas rápidas. Uma advogada especialista analisa seu caso."></textarea>
              </div>
              <div class="form-group">
                <label for="q-og-image">Imagem do preview</label>
                <input type="text" id="q-og-image" placeholder="/images/og-quiz.jpg" />
                <span class="form-hint">Caminho do site ou URL completa. Em branco usa a imagem padrão dos quizzes</span>
              </div>
            </div>
          </div>

          <div class="builder">
            <div class="builder-header">
              <div>
                <h3>Perguntas</h3>
                <p class="form-hint">Uma opção por linha, mínimo de 2 opções por pergunta</p>
              </div>
              <button type="button" class="btn-add-question" id="btn-add-question">+ Adicionar pergunta</button>
            </div>
            <div class="questions-list" id="questions-list"></div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button class="btn-secondary" id="btn-cancel">Cancelar</button>
        <button class="btn-primary" id="btn-save">Criar quiz</button>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <script>
    interface QuizQuestion { text: string; options: string[] }

    const overlay = document.getElementById('modal-overlay')!;
    const modalTitle = document.getElementById('modal-title')!;
    const btnOpen = document.getElementById('btn-open-modal')!;
    const btnClose = document.getElementById('btn-close-modal')!;
    const btnCancel = document.getElementById('btn-cancel')!;
    const btnSave = document.getElementById('btn-save') as HTMLButtonElement;
    const btnAddQuestion = document.getElementById('btn-add-question')!;
    const questionsList = document.getElementById('questions-list')!;
    const groupSourceTag = document.getElementById('group-source-tag')!;
    const modalError = document.getElementById('modal-error')!;
    const toast = document.getElementById('toast')!;

    let toastTimer: ReturnType<typeof setTimeout>;
    let editingId: string | null = null;

    function showToast(msg: string) {
      toast.textContent = msg;
      toast.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove('show'), 2500);
    }

    function input(id: string) {
      return document.getElementById(id) as HTMLInputElement;
    }

    // ----- Builder de perguntas -----
    function addQuestion(question?: QuizQuestion) {
      const item = document.createElement('div');
      item.className = 'question-item';
      item.innerHTML = `
        <div class="question-item-header">
          <span class="question-index"></span>
          <button type="button" class="btn-remove-question">Remover</button>
        </div>
        <input type="text" class="q-text" placeholder="Enunciado da pergunta" />
        <textarea class="q-options" placeholder="Opção 1&#10;Opção 2&#10;Opção 3"></textarea>
      `;

      (item.querySelector('.q-text') as HTMLInputElement).value = question?.text ?? '';
      (item.querySelector('.q-options') as HTMLTextAreaElement).value = (question?.options ?? []).join('\n');

      item.querySelector('.btn-remove-question')!.addEventListener('click', () => {
        item.remove();
        renumberQuestions();
      });

      questionsList.appendChild(item);
      renumberQuestions();

      if (!question) (item.querySelector('.q-text') as HTMLInputElement).focus();
    }

    function renumberQuestions() {
      const items = Array.from(questionsList.querySelectorAll('.question-item'));
      items.forEach((item, i) => {
        item.querySelector('.question-index')!.textContent = `Pergunta ${i + 1}`;
      });

      const empty = questionsList.querySelector('.builder-empty');
      if (items.length === 0 && !empty) {
        const placeholder = document.createElement('div');
        placeholder.className = 'builder-empty';
        placeholder.textContent = 'Nenhuma pergunta ainda. Adicione a primeira.';
        questionsList.appendChild(placeholder);
      } else if (items.length > 0 && empty) {
        empty.remove();
      }
    }

    function collectQuestions(): QuizQuestion[] {
      return Array.from(questionsList.querySelectorAll('.question-item')).map((item) => ({
        text: (item.querySelector('.q-text') as HTMLInputElement).value.trim(),
        options: (item.querySelector('.q-options') as HTMLTextAreaElement).value
          .split('\n')
          .map((o) => o.trim())
          .filter(Boolean),
      }));
    }

    function validateQuestions(questions: QuizQuestion[]): string | null {
      if (questions.length === 0) return 'Adicione pelo menos uma pergunta.';
      for (const [i, q] of questions.entries()) {
        if (!q.text) return `A pergunta ${i + 1} está sem enunciado.`;
        if (q.options.length < 2) return `A pergunta ${i + 1} precisa de pelo menos 2 opções.`;
      }
      return null;
    }

    btnAddQuestion.addEventListener('click', () => addQuestion());

    // ----- Modal -----
    function openModal() {
      overlay.classList.add('open');
      input('q-name').focus();
    }

    function openCreateModal() {
      editingId = null;
      modalTitle.textContent = 'Novo quiz';
      btnSave.textContent = 'Criar quiz';
      groupSourceTag.style.display = '';
      (document.getElementById('quiz-form') as HTMLFormElement).reset();
      delete input('q-source-tag').dataset.edited;
      questionsList.innerHTML = '';
      addQuestion();
      modalError.style.display = 'none';
      openModal();
    }

    function closeModal() {
      overlay.classList.remove('open');
      editingId = null;
      modalError.style.display = 'none';
    }

    btnOpen.addEventListener('click', openCreateModal);
    btnClose.addEventListener('click', closeModal);
    btnCancel.addEventListener('click', closeModal);
    overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });

    // Auto-gerar source_tag a partir do nome interno
    input('q-name').addEventListener('input', (e) => {
      const tagInput = input('q-source-tag');
      if (editingId || tagInput.dataset.edited) return;
      tagInput.value = (e.target as HTMLInputElement).value
        .toLowerCase()
        .normalize('NFD').replace(/[̀-ͯ]/g, '')
        .replace(/[^a-z0-9\s-]/g, '')
        .trim()
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-');
    });

    input('q-source-tag').addEventListener('input', function () {
      (this as HTMLInputElement).dataset.edited = '1';
    });

    function showError(msg: string) {
      modalError.textContent = msg;
      modalError.style.display = 'block';
    }

    btnSave.addEventListener('click', async () => {
      modalError.style.display = 'none';

      const name = input('q-name').value.trim();
      const title = input('q-title').value.trim();
      const subtitle = input('q-subtitle').value.trim() || null;
      const sourceTag = input('q-source-tag').value.trim();
      const service = input('q-service').value.trim() || null;
      const whatsapp = input('q-whatsapp').value.trim() || null;
      const metaTitle = input('q-meta-title').value.trim() || null;
      const metaDescription = (document.getElementById('q-meta-description') as HTMLTextAreaElement).value.trim() || null;
      const ogImage = input('q-og-image').value.trim() || null;
      const successMsg = (document.getElementById('q-success') as HTMLTextAreaElement).value.trim()
        || 'Obrigado! Entraremos em contato em breve.';

      if (!name || !title || (!editingId && !sourceTag)) {
        showError('Nome interno, título e source tag são obrigatórios.');
        return;
      }

      const questions = collectQuestions();
      const questionError = validateQuestions(questions);
      if (questionError) {
        showError(questionError);
        return;
      }

      const originalLabel = btnSave.textContent;
      btnSave.textContent = 'Salvando…';
      btnSave.disabled = true;

      const payload: Record<string, unknown> = {
        name,
        title,
        subtitle,
        service_interest: service,
        whatsapp_number: whatsapp,
        meta_title: metaTitle,
        meta_description: metaDescription,
        og_image: ogImage,
        success_message: successMsg,
        questions,
      };

      try {
        const res = editingId
          ? await fetch(`/api/quizzes/${editingId}`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            })
          : await fetch('/api/quizzes/create', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ ...payload, source_tag: sourceTag }),
            });

        const data = await res.json();

        if (!res.ok) {
          showError(data.error ?? 'Erro ao salvar quiz.');
          btnSave.textContent = originalLabel;
          btnSave.disabled = false;
          return;
        }

        const wasEditing = !!editingId;
        closeModal();
        showToast(wasEditing ? 'Quiz atualizado!' : 'Quiz criado com sucesso!');
        setTimeout(() => location.reload(), 800);
      } catch {
        showError('Erro de conexão.');
        btnSave.textContent = originalLabel;
        btnSave.disabled = false;
      }
    });

    // ----- Ações da tabela -----
    function editQuiz(btn: HTMLButtonElement) {
      const quiz = JSON.parse(btn.dataset.quiz ?? '{}');

      editingId = btn.dataset.id ?? null;
      modalTitle.textContent = 'Editar quiz';
      btnSave.textContent = 'Salvar alterações';
      groupSourceTag.style.display = 'none';

      input('q-name').value = quiz.name ?? '';
      input('q-title').value = quiz.title ?? '';
      input('q-subtitle').value = quiz.subtitle ?? '';
      input('q-service').value = quiz.service_interest ?? '';
      input('q-whatsapp').value = quiz.whatsapp_number ?? '';
      input('q-meta-title').value = quiz.meta_title ?? '';
      (document.getElementById('q-meta-description') as HTMLTextAreaElement).value = quiz.meta_description ?? '';
      input('q-og-image').value = quiz.og_image ?? '';
      (document.getElementById('q-success') as HTMLTextAreaElement).value = quiz.success_message ?? '';

      questionsList.innerHTML = '';
      (quiz.questions ?? []).forEach((q: QuizQuestion) => addQuestion(q));
      renumberQuestions();

      modalError.style.display = 'none';
      openModal();
    }

    function copyText(btn: HTMLButtonElement) {
      const text = btn.dataset.copy ?? '';
      navigator.clipboard.writeText(text).then(() => {
        const orig = btn.textContent;
        btn.textContent = 'Copiado!';
        setTimeout(() => { btn.textContent = orig; }, 1800);
      });
    }

    async function toggleQuiz(btn: HTMLButtonElement) {
      const id = btn.dataset.id;
      const active = btn.dataset.active === 'true';
      btn.disabled = true;

      const res = await fetch('/api/quizzes/toggle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, is_active: !active }),
      });

      if (res.ok) {
        showToast(active ? 'Quiz desativado.' : 'Quiz ativado.');
        setTimeout(() => location.reload(), 600);
      } else {
        showToast('Erro ao alterar status.');
        btn.disabled = false;
      }
    }

    async function deleteQuiz(btn: HTMLButtonElement) {
      const name = btn.dataset.name;
      if (!confirm(`Excluir o quiz "${name}"?\n\nAs respostas registradas também serão removidas. Os leads já capturados não serão afetados.`)) return;

      const id = btn.dataset.id;
      btn.disabled = true;

      const res = await fetch(`/api/quizzes/${id}`, { method: 'DELETE' });

      if (res.ok) {
        showToast('Quiz excluído.');
        setTimeout(() => location.reload(), 600);
      } else {
        showToast('Erro ao excluir quiz.');
        btn.disabled = false;
      }
    }

    (window as any).copyText = copyText;
    (window as any).editQuiz = editQuiz;
    (window as any).toggleQuiz = toggleQuiz;
    (window as any).deleteQuiz = deleteQuiz;

    // Mobile drawer
    const hamburger = document.getElementById('hamburger-btn');
    const mobileOverlay = document.getElementById('mobile-overlay');
    const drawer = document.getElementById('mobile-drawer');
    const drawerClose = document.getElementById('drawer-close');

    function openDrawer() {
      mobileOverlay?.classList.add('open');
      drawer?.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeDrawer() {
      mobileOverlay?.classList.remove('open');
      drawer?.classList.remove('open');
      document.body.style.overflow = '';
    }
    hamburger?.addEventListener('click', openDrawer);
    mobileOverlay?.addEventListener('click', closeDrawer);
    drawerClose?.addEventListener('click', closeDrawer);
  </script>
</body>
</html>
