      .actions {
        justify-content: flex-start;
        margin-top: 0.5rem;
      }
      .modal {
        max-width: 100%;
        margin: 0.5rem;
        border-radius: 14px;
      }
      .form-row { grid-template-columns: 1fr; }
      .modal-header { padding: 1.25rem 1.25rem 0.75rem; }
      .modal-body { padding: 1rem 1.25rem; }
      .modal-footer { padding: 0.75rem 1.25rem 1.25rem; }
    }
  </style>
</head>
<body>
