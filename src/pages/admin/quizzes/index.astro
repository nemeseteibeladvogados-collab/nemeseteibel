---
export const prerender = false;

const user = Astro.locals.user;
const supabase = Astro.locals.supabase;

interface QuizQuestion {
  text: string;
  options: string[];
}

interface Quiz {
  id: string;
  name: string;
  title: string;
  subtitle: string | null;
  source_tag: string;
  service_interest: string | null;
  whatsapp_number: string | null;
  meta_title: string | null;
  meta_description: string | null;
  og_image: string | null;
  questions: QuizQuestion[];
  success_message: string;
  is_active: boolean;
  created_at: string;
}

const { data: quizzes } = await supabase
  .from('quizzes')
  .select('*')
  .order('created_at', { ascending: false });

const quizList: Quiz[] = (quizzes ?? []).map((q: Quiz) => ({
  ...q,
  questions: Array.isArray(q.questions) ? q.questions : [],
}));

// Funil por quiz: quantos iniciaram e quantos concluíram
const funnel: Record<string, { started: number; completed: number }> = {};

if (quizList.length > 0) {
  const { data: responses } = await supabase
    .from('quiz_responses')
    .select('quiz_id, status')
    .in('quiz_id', quizList.map((q) => q.id));

  (responses ?? []).forEach((row: { quiz_id: string; status: string }) => {
    const entry = funnel[row.quiz_id] ?? (funnel[row.quiz_id] = { started: 0, completed: 0 });
    entry.started += 1;
    if (row.status === 'completed') entry.completed += 1;
  });
}

const siteUrl = Astro.url.origin;
---

<!DOCTYPE html>
