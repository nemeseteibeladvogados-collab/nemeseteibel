---
export const prerender = false;

const user = Astro.locals.user;
const supabase = Astro.locals.supabase;
const { id } = Astro.params;

interface QuizQuestion {
  text: string;
  options: string[];
}

interface ResponseRow {
  id: string;
  status: string;
  answers: { question: string; answer: string }[];
  started_at: string;
  completed_at: string | null;
  contacts: { name: string; email: string; phone: string | null } | null;
}

const { data: quiz } = await supabase
  .from('quizzes')
  .select('id, name, title, source_tag, questions, is_active')
  .eq('id', id!)
  .single();

if (!quiz) {
  return Astro.redirect('/admin/quizzes');
}

const questions: QuizQuestion[] = Array.isArray(quiz.questions) ? quiz.questions : [];

const { data: rows } = await supabase
  .from('quiz_responses')
  .select('id, status, answers, started_at, completed_at, contacts(name, email, phone)')
  .eq('quiz_id', id!)
  .order('started_at', { ascending: false });

const responses: ResponseRow[] = (rows ?? []) as unknown as ResponseRow[];
const completed = responses.filter((r) => r.status === 'completed');
const started = responses.length;
const rate = started > 0 ? Math.round((completed.length / started) * 100) : 0;

// Distribuição por pergunta, montada a partir do que foi realmente gravado.
// Assim, editar as perguntas depois não apaga o histórico já coletado.
const tally = new Map<string, Map<string, number>>();

completed.forEach((r) => {
  (Array.isArray(r.answers) ? r.answers : []).forEach(({ question, answer }) => {
    if (!question || !answer) return;
    const perQuestion = tally.get(question) ?? new Map<string, number>();
    perQuestion.set(answer, (perQuestion.get(answer) ?? 0) + 1);
    tally.set(question, perQuestion);
  });
});

// Perguntas atuais primeiro, na ordem do quiz; depois as que só existem no histórico.
const currentTexts = questions.map((q) => q.text);
const orphanTexts = [...tally.keys()].filter((t) => !currentTexts.includes(t));

const breakdown = [
  ...questions.map((q) => ({ text: q.text, options: q.options, current: true })),
  ...orphanTexts.map((t) => ({ text: t, options: [] as string[], current: false })),
].map((q) => {
  const counts = tally.get(q.text) ?? new Map<string, number>();
  const total = [...counts.values()].reduce((a, b) => a + b, 0);

  // Opções atuais mesmo com zero resposta, mais qualquer resposta antiga fora da lista.
  const labels = [...new Set([...q.options, ...counts.keys()])];

  return {
    text: q.text,
    current: q.current,
    total,
    rows: labels
      .map((label) => {
        const n = counts.get(label) ?? 0;
        return { label, n, pct: total > 0 ? Math.round((n / total) * 100) : 0, known: q.options.includes(label) };
      })
      .sort((a, b) => b.n - a.n),
  };
});

function formatDate(value: string) {
  return new Date(value).toLocaleString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
}
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{quiz.name} — Respostas — Nemes & Teibel Admin</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'DM Sans', system-ui, sans-serif;
      background: #F0EDE6;
      min-height: 100vh;
      color: #3D3828;
    }

    .topbar {
      background: #3A3426;
      padding: 0 2rem;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .topbar-left { display: flex; align-items: center; gap: 1.5rem; }

    .topbar-brand {
      font-family: 'Playfair Display', serif;
      font-size: 1.05rem;
      color: #F5F0E8;
      font-weight: 700;
      text-decoration: none;
    }

    .topbar-brand span { color: #B8972A; }

    .topbar-nav { display: flex; gap: 0.25rem; }

    .nav-link {
      font-size: 0.82rem;
      color: rgba(245, 240, 232, 0.6);
      text-decoration: none;
      padding: 0.35rem 0.75rem;
      border-radius: 6px;
      transition: all 0.2s;
    }

    .nav-link:hover { color: #F5F0E8; background: rgba(245,240,232,0.08); }
    .nav-link.active { color: #F5F0E8; background: rgba(245,240,232,0.12); }

    .topbar-right { display: flex; align-items: center; gap: 1rem; }

    .user-badge { font-size: 0.8rem; color: rgba(245, 240, 232, 0.65); }

    .btn-logout {
      background: transparent;
      border: 1px solid rgba(245, 240, 232, 0.3);
      color: #F5F0E8;
      padding: 0.4rem 0.875rem;
      border-radius: 50px;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.8rem;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.2s;
    }

    .btn-logout:hover { background: rgba(245, 240, 232, 0.1); }

    .hamburger {
      display: none;
      background: none;
      border: none;
      cursor: pointer;
      padding: 0.5rem;
      color: #F5F0E8;
    }

    .hamburger svg { display: block; }

    .mobile-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(58, 52, 38, 0.5);
      z-index: 199;
    }

    .mobile-overlay.open { display: block; }

    .mobile-drawer {
      display: none;
      position: fixed;
      top: 0;
      right: 0;
      width: 260px;
      height: 100%;
      background: #3A3426;
      z-index: 200;
      padding: 1.25rem;
      transform: translateX(100%);
      transition: transform 0.3s ease;
      overflow-y: auto;
    }

    .mobile-drawer.open {
      display: block;
      transform: translateX(0);
    }

    .drawer-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid rgba(245, 240, 232, 0.1);
    }

    .drawer-header span {
      font-size: 0.8rem;
      color: rgba(245, 240, 232, 0.65);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      max-width: 170px;
    }

    .drawer-close {
      background: none;
      border: none;
      color: #F5F0E8;
      cursor: pointer;
      padding: 0.25rem;
    }

    .drawer-nav {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      margin-bottom: 1.5rem;
    }

    .drawer-nav a {
      font-size: 0.9rem;
      color: rgba(245, 240, 232, 0.7);
      text-decoration: none;
      padding: 0.7rem 0.75rem;
      border-radius: 8px;
      transition: all 0.2s;
    }

    .drawer-nav a:hover { color: #F5F0E8; background: rgba(245, 240, 232, 0.08); }
    .drawer-nav a.active { color: #F5F0E8; background: rgba(245, 240, 232, 0.12); }

    .drawer-logout .btn-logout {
      width: 100%;
      text-align: center;
      padding: 0.6rem;
    }

    @media (max-width: 768px) {
      .topbar { padding: 0 1rem; }
      .topbar-nav { display: none; }
      .topbar-right { display: none; }
      .hamburger { display: block; }
    }

    .main {
      max-width: 1100px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      font-size: 0.8rem;
      font-weight: 600;
      color: #9A9285;
      text-decoration: none;
      margin-bottom: 0.75rem;
      transition: color 0.2s;
    }

    .back-link:hover { color: #3A3426; }

    .page-header { margin-bottom: 1.75rem; }

    .page-header h1 {
      font-family: 'Playfair Display', serif;
      font-size: 1.75rem;
      color: #3A3426;
      font-weight: 700;
    }

    .header-meta {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      flex-wrap: wrap;
      margin-top: 0.4rem;
      font-size: 0.8rem;
      color: #9A9285;
    }

    .td-tag { font-family: monospace; font-size: 0.78rem; color: #8C7355; background: #F5F0E8; padding: 0.2rem 0.5rem; border-radius: 4px; }

    .status-dot {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      margin-right: 0.35rem;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      margin-bottom: 1.75rem;
    }

    .stat-card {
      background: #fff;
      border-radius: 14px;
      box-shadow: 0 2px 8px rgba(58, 52, 38, 0.08);
      padding: 1.25rem 1.5rem;
    }

    .stat-label {
      font-size: 0.72rem;
      font-weight: 700;
      color: #9A9285;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .stat-value {
      font-family: 'Playfair Display', serif;
      font-size: 1.9rem;
      font-weight: 700;
      color: #3A3426;
      margin-top: 0.3rem;
      line-height: 1;
    }

    .stat-sub { font-size: 0.75rem; color: #9A9285; margin-top: 0.3rem; }

    .card {
      background: #fff;
      border-radius: 14px;
      box-shadow: 0 2px 8px rgba(58, 52, 38, 0.08);
      overflow: hidden;
      margin-bottom: 1.75rem;
    }

    .card-header {
      padding: 1rem 1.5rem;
      border-bottom: 1px solid rgba(58, 52, 38, 0.08);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .card-header h2 { font-size: 0.95rem; font-weight: 700; color: #3A3426; }

    .count {
      font-size: 0.78rem;
      background: #F5F0E8;
      color: #8C7355;
      padding: 0.25rem 0.625rem;
      border-radius: 50px;
      font-weight: 600;
      white-space: nowrap;
    }

    .question-block {
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid rgba(58, 52, 38, 0.06);
    }

    .question-block:last-child { border-bottom: none; }

    .question-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 0.9rem;
    }

    .question-text {
      font-size: 0.9rem;
      font-weight: 600;
      color: #3A3426;
      line-height: 1.45;
    }

    .question-total { font-size: 0.75rem; color: #9A9285; white-space: nowrap; }

    .badge-removed {
      font-size: 0.68rem;
      font-weight: 700;
      color: #B45309;
      background: #FEF9EE;
      border: 1px solid #FDE68A;
      padding: 0.1rem 0.45rem;
      border-radius: 50px;
      margin-left: 0.4rem;
      white-space: nowrap;
    }

    .bars { display: flex; flex-direction: column; gap: 0.55rem; }

    .bar-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.75rem;
    }

    .bar-label {
      font-size: 0.82rem;
      color: #3D3828;
      margin-bottom: 0.3rem;
      line-height: 1.4;
    }

    .bar-label .orphan { color: #B45309; font-size: 0.7rem; font-weight: 600; }

    .bar-track {
      height: 7px;
      background: rgba(58, 52, 38, 0.08);
      border-radius: 50px;
      overflow: hidden;
    }

    .bar-fill {
      height: 100%;
      background: #B8972A;
      border-radius: 50px;
    }

    .bar-fill.zero { background: transparent; }

    .bar-value {
      font-size: 0.8rem;
      font-weight: 700;
      color: #3A3426;
      white-space: nowrap;
      min-width: 68px;
      text-align: right;
    }

    .bar-value span { font-weight: 500; color: #9A9285; }

    table { width: 100%; border-collapse: collapse; }

    thead th {
      text-align: left;
      font-size: 0.72rem;
      font-weight: 700;
      color: #9A9285;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 0.75rem 1.5rem;
      border-bottom: 1px solid rgba(58, 52, 38, 0.08);
    }

    tbody tr { transition: background 0.15s; }
    tbody tr:hover { background: #FAFAF8; }

    tbody td {
      padding: 0.875rem 1.5rem;
      font-size: 0.85rem;
      border-bottom: 1px solid rgba(58, 52, 38, 0.06);
      color: #3D3828;
      vertical-align: top;
    }

    tbody tr:last-child td { border-bottom: none; }

    .td-name { font-weight: 600; }
    .td-contact { font-size: 0.78rem; color: #8C7355; line-height: 1.6; }

    .answer-list {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .answer-list li { font-size: 0.8rem; line-height: 1.45; }
    .answer-list .q { color: #9A9285; }
    .answer-list .a { color: #3A3426; font-weight: 600; }

    .pill {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 700;
      padding: 0.15rem 0.5rem;
      border-radius: 50px;
      white-space: nowrap;
    }

    .pill-completed { color: #166534; background: #F0FDF4; border: 1px solid #BBF7D0; }
    .pill-started { color: #9A9285; background: #F5F0E8; border: 1px solid #E5DDD0; }

    .empty-state {
      text-align: center;
      padding: 3rem 1.5rem;
      color: #9A9285;
    }

    .empty-state .icon { font-size: 2.25rem; margin-bottom: 0.75rem; }
    .empty-state p { font-size: 0.875rem; }

    @media (max-width: 768px) {
      .main { padding: 1.25rem 1rem; }
      .page-header h1 { font-size: 1.35rem; }
      .stats { grid-template-columns: 1fr; gap: 0.75rem; }

      table, thead, tbody, th, td, tr { display: block; }
      thead { display: none; }
      tbody tr {
        padding: 1rem;
        border-bottom: 1px solid rgba(58, 52, 38, 0.1);
      }
      tbody tr:last-child { border-bottom: none; }
      tbody td {
        padding: 0.25rem 0;
        border-bottom: none;
        display: flex;
        justify-content: space-between;
        gap: 1rem;
      }
      tbody td::before {
        content: attr(data-label);
        font-size: 0.7rem;
        font-weight: 700;
        color: #9A9285;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        min-width: 80px;
        flex-shrink: 0;
      }
      tbody td[data-label="Respostas"] { display: block; }
      tbody td[data-label="Respostas"]::before { display: block; margin-bottom: 0.4rem; }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-left">
      <a href="/admin" class="topbar-brand">Nemes <span>&</span> Teibel — Admin</a>
      <nav class="topbar-nav">
        <a href="/admin" class="nav-link">Dashboard</a>
        <a href="/admin/paginas" class="nav-link">Páginas</a>
        <a href="/admin/materiais" class="nav-link">Materiais</a>
        <a href="/admin/formularios" class="nav-link">Formulários</a>
        <a href="/admin/quizzes" class="nav-link active">Quizzes</a>
        <a href="/admin/usuarios" class="nav-link">Usuários</a>
      </nav>
    </div>
    <div class="topbar-right">
      <span class="user-badge">{user?.email}</span>
      <form method="POST" action="/api/auth/logout">
        <button type="submit" class="btn-logout">Sair</button>
      </form>
    </div>
    <button class="hamburger" id="hamburger-btn" aria-label="Abrir menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </header>

  <div class="mobile-overlay" id="mobile-overlay"></div>
  <div class="mobile-drawer" id="mobile-drawer">
    <div class="drawer-header">
      <span>{user?.email}</span>
      <button class="drawer-close" id="drawer-close" aria-label="Fechar menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <nav class="drawer-nav">
      <a href="/admin">Dashboard</a>
      <a href="/admin/paginas">Páginas</a>
      <a href="/admin/materiais">Materiais</a>
      <a href="/admin/formularios">Formulários</a>
      <a href="/admin/quizzes" class="active">Quizzes</a>
      <a href="/admin/usuarios">Usuários</a>
    </nav>
    <div class="drawer-logout">
      <form method="POST" action="/api/auth/logout">
        <button type="submit" class="btn-logout">Sair</button>
      </form>
    </div>
  </div>

  <main class="main">
    <a href="/admin/quizzes" class="back-link">← Voltar para quizzes</a>

    <div class="page-header">
      <h1>{quiz.name}</h1>
      <div class="header-meta">
        <span class="td-tag">{quiz.source_tag}</span>
        <span>
          <span class="status-dot" style={`background:${quiz.is_active ? '#3DBE4F' : '#9A9285'}`}></span>
          {quiz.is_active ? 'Ativo' : 'Inativo'}
        </span>
        <span>·</span>
        <span>{questions.length} perguntas</span>
      </div>
    </div>

    <div class="stats">
      <div class="stat-card">
        <div class="stat-label">Iniciaram</div>
        <div class="stat-value">{started}</div>
        <div class="stat-sub">responderam ao menos 1 pergunta</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Concluíram</div>
        <div class="stat-value">{completed.length}</div>
        <div class="stat-sub">deixaram o contato</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Taxa de conclusão</div>
        <div class="stat-value">{rate}%</div>
        <div class="stat-sub">{started - completed.length} abandonaram no meio</div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h2>Distribuição por pergunta</h2>
        <span class="count">base: {completed.length} respostas concluídas</span>
      </div>

      {completed.length === 0 ? (
        <div class="empty-state">
          <div class="icon">📊</div>
          <p>Nenhuma resposta concluída ainda. Os percentuais aparecem aqui assim que o primeiro lead terminar o quiz.</p>
        </div>
      ) : (
        breakdown.map((q) => (
          <div class="question-block">
            <div class="question-head">
              <div class="question-text">
                {q.text}
                {!q.current && <span class="badge-removed">pergunta removida</span>}
              </div>
              <div class="question-total">{q.total} resp.</div>
            </div>
            <div class="bars">
              {q.rows.map((row) => (
                <div>
                  <div class="bar-label">
                    {row.label}
                    {!row.known && <span class="orphan"> · opção antiga</span>}
                  </div>
                  <div class="bar-row">
                    <div class="bar-track">
                      <div class="bar-fill" class:list={[row.n === 0 && 'zero']} style={`width:${row.pct}%`}></div>
                    </div>
                    <div class="bar-value">{row.pct}% <span>({row.n})</span></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))
      )}
    </div>

    <div class="card">
      <div class="card-header">
        <h2>Respostas individuais</h2>
        <span class="count">{responses.length} registros</span>
      </div>

      {responses.length === 0 ? (
        <div class="empty-state">
          <div class="icon">📭</div>
          <p>Ninguém respondeu este quiz ainda. Compartilhe o link e as respostas aparecem aqui.</p>
        </div>
      ) : (
        <table>
          <thead>
            <tr>
              <th>Quando</th>
              <th>Lead</th>
              <th>Respostas</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {responses.map((r) => (
              <tr>
                <td data-label="Quando">{formatDate(r.completed_at ?? r.started_at)}</td>
                <td data-label="Lead">
                  {r.contacts ? (
                    <>
                      <div class="td-name">{r.contacts.name}</div>
                      <div class="td-contact">
                        {r.contacts.email && !r.contacts.email.endsWith('@noemail.local') && <div>{r.contacts.email}</div>}
                        {r.contacts.phone && <div>{r.contacts.phone}</div>}
                      </div>
                    </>
                  ) : (
                    <span class="td-contact">— não chegou ao contato</span>
                  )}
                </td>
                <td data-label="Respostas">
                  {r.answers?.length > 0 ? (
                    <ul class="answer-list">
                      {r.answers.map((a) => (
                        <li><span class="q">{a.question}</span><br /><span class="a">→ {a.answer}</span></li>
                      ))}
                    </ul>
                  ) : (
                    <span class="td-contact">—</span>
                  )}
                </td>
                <td data-label="Status">
                  <span class="pill" class:list={[r.status === 'completed' ? 'pill-completed' : 'pill-started']}>
                    {r.status === 'completed' ? 'Concluiu' : 'Abandonou'}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  </main>

  <script>
    const hamburger = document.getElementById('hamburger-btn');
    const mobileOverlay = document.getElementById('mobile-overlay');
    const drawer = document.getElementById('mobile-drawer');
    const drawerClose = document.getElementById('drawer-close');

    function openDrawer() {
      mobileOverlay?.classList.add('open');
      drawer?.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeDrawer() {
      mobileOverlay?.classList.remove('open');
      drawer?.classList.remove('open');
      document.body.style.overflow = '';
    }
    hamburger?.addEventListener('click', openDrawer);
    mobileOverlay?.addEventListener('click', closeDrawer);
    drawerClose?.addEventListener('click', closeDrawer);
  </script>
</body>
</html>
